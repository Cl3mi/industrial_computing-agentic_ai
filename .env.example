# Pick one backend. OpenRouter is used when OPENROUTER_API_KEY is set, otherwise Ollama.
OPENROUTER_API_KEY=
# Any tool-calling model on OpenRouter; check the current model list before the demo.
LLM_MODEL=openrouter/google/gemini-2.5-flash
# Ollama fallback
OLLAMA_MODEL=ollama_chat/qwen3:8b
OLLAMA_API_BASE=http://localhost:11434
# Server paths (defaults shown)
SPAREPARTS_DB=data/inventory.db
SPAREPARTS_LOG=data/audit.log
# Homework 2: LiteLLM proxy as A2A agent registry (compose default shown)
LITELLM_MASTER_KEY=sk-spareparts-local
# Orchestrator on the host talks to the proxy on port 4000; inside compose this is overridden
LITELLM_URL=http://127.0.0.1:4000
